{
  "name": "@mahope/deskuptime",
  "version": "0.2.8",
  "description": "Website uptime monitor CLI — uptime, SSL expiry & content change alerts from your terminal or CI. Zero dependencies, works on any URL/CMS.",
  "main": "src/engine.js",
  "bin": {
    "deskuptime": "src/cli.js"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/test.js test/license.test.js test/status.test.js test/webhook.test.js test/claims.test.js test/tarball.test.js test/install.test.js",
    "audit": "npm audit",
    "check": "node src/cli.js check https://example.com",
    "release": "node tools/release.mjs"
  },
  "keywords": [
    "uptime",
    "monitoring",
    "ssl",
    "website-monitor",
    "cli",
    "devops",
    "status-page",
    "health-check",
    "ci",
    "github-action"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahope/deskuptime.git"
  },
  "homepage": "https://github.com/mahope/deskuptime",
  "bugs": "https://github.com/mahope/deskuptime/issues",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src/",
    "docs/",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
