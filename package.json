{
  "name": "@mahope/deskuptime",
  "version": "0.2.8",
  "description": "Uptime, SSL expiry and content-change alerts from your terminal or CI. Free MIT CLI — DeskUptime Pro ($19 one-time, 3 machines) adds unlimited URLs, webhook alerts, client reports, the desktop app.",
  "main": "src/engine.js",
  "bin": {
    "deskuptime": "src/cli.js"
  },
  "type": "module",
  "scripts": {
    "test": "node tools/run-tests.mjs",
    "test:isolation": "node tools/run-tests.mjs test/isolation.test.js",
    "audit": "npm audit",
    "check": "node src/cli.js check https://example.com",
    "release": "node tools/release.mjs",
    "matrix": "node tools/matrix.mjs"
  },
  "keywords": [
    "uptime",
    "monitoring",
    "ssl",
    "website-monitor",
    "cli",
    "devops",
    "status-page",
    "health-check",
    "ci",
    "github-action"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahope/deskuptime.git"
  },
  "homepage": "https://github.com/mahope/deskuptime",
  "bugs": "https://github.com/mahope/deskuptime/issues",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src/",
    "docs/",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
